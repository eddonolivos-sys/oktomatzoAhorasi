# Domain for production (Caddy auto-configures HTTPS)
DOMAIN=plataforma.ejemplo.com

# JWT secret (generate with: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-secure-random-string

# Optional: enable debug mode
DEBUG=false

# Cesium Ion access token (required for app-mundo-3d)
VITE_CESIUM_ION_TOKEN=

# Optional: 3D model URLs for app-mundo-3d
VITE_MODEL_CAR_URL=
VITE_MODEL_PLANE_URL=
VITE_MODEL_BOAT_URL=
