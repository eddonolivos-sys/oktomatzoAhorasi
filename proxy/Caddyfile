{
	admin off
}

# Production: uses domain from env variable
{$DOMAIN:localhost:8080} {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# API backend (must be first)
	handle /api/* {
		reverse_proxy backend:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Sub-app: Dashboard
	handle_path /apps/dashboard/* {
		reverse_proxy app-dashboard:80
	}

	# Sub-app: Viewer 3D
	handle_path /apps/viewer-3d/* {
		reverse_proxy app-viewer-3d:80
	}

	# Sub-app: Mundo 3D (CesiumJS)
	handle_path /apps/mundo-3d/* {
		reverse_proxy app-mundo-3d:80
	}

	# Sub-app: Combate 3D
	handle_path /apps/combate-3d/* {
		reverse_proxy app-combate-3d:80
	}

	# Game WebSocket server
	handle /ws {
		reverse_proxy game-server:8080
	}

	# Space WebSocket server (multiplayer presence)
	handle /space-ws {
		reverse_proxy space-server:8080
	}

	# Documentación y búsqueda
	handle /docs/* {
		uri strip_prefix /docs
		root * /usr/share/docs
		file_server
	}

	# Sub-app: Oktomatzo2 TattooAR
	handle_path /apps/oktomatzo2/* {
		reverse_proxy oktomatzo2-app:3000
	}

	handle /oktomatzo2-api/* {
		uri strip_prefix /oktomatzo2-api
		reverse_proxy oktomatzo2-api:8000
	}

	# Test: Project 1
	handle_path /apps/test-uno/* {
		reverse_proxy test-uno:80
	}

	# Test: Project 2
	handle_path /apps/test-dos/* {
		reverse_proxy test-dos:80
	}

	# Static files caching
	header /assets/* Cache-Control "public, immutable, max-age=31536000"

	# Shell SPA (catch-all: must be last)
	handle {
		reverse_proxy shell:80
	}

	log {
		output file /var/log/caddy/access.log
		level INFO
	}
}

